{
  "dependencies": {
    "@valfuse-node/express": "0.2.0",
    "@valfuse-node/localization": "0.5.0",
    "@valfuse-node/validation": "0.1.0",
    "awilix": "13.0.5",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "pino": "10.4.0",
    "sequelize": "6.37.8",
    "umzug": "3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.62.1",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@valfuse-node/barrel": "^0.2.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "name": "express-rest-api-boilerplate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.0",
  "scripts": {
    "prepare": "node .husky/install.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node --env-file-if-exists=.env --import tsx --watch bin/www.ts",
    "start": "node --enable-source-maps dist/bin/www.js",
    "build": "npm run clean && npm run generate && tsc -p tsconfig.build.json && npm run docs:build",
    "generate": "npm run i18n:generate && npm run barrel:generate && npm run api:generate",
    "i18n:generate": "node --import tsx scripts/generate-localization.ts",
    "i18n:check": "valfuse-localization validate && node --import tsx scripts/generate-localization.ts --check",
    "barrel:generate": "node --import tsx scripts/generate-barrel.ts",
    "barrel:check": "node --import tsx scripts/generate-barrel.ts --check",
    "api:lint": "redocly lint docs/api/openapi.yaml",
    "api:generate": "openapi-typescript docs/api/openapi.yaml -o src/generated/openapi.type.ts && node --import tsx scripts/generate-api-docs.ts",
    "api:check": "npm run api:lint && openapi-typescript docs/api/openapi.yaml -o src/generated/openapi.type.ts --check && node --import tsx scripts/generate-api-docs.ts --check",
    "docs:build": "redocly bundle docs/api/openapi.yaml -o dist/docs/openapi.yaml && redocly build-docs docs/api/openapi.yaml -o dist/docs/index.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "layout:check": "node --import tsx scripts/check-source-layout.ts",
    "check": "npm run layout:check && npm run api:check && npm run i18n:check && npm run barrel:check && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "ci": "npm run check && npm run db:wait:test && npm run test:integration && npm run build",
    "db:migrate": "node --env-file-if-exists=.env --import tsx bin/migrate.ts up",
    "db:pending": "node --env-file-if-exists=.env --import tsx bin/migrate.ts pending",
    "db:undo": "node --env-file-if-exists=.env --import tsx bin/migrate.ts down",
    "db:migrate:production": "node dist/bin/migrate.js up",
    "db:seed": "node --env-file-if-exists=.env --import tsx bin/seed.ts",
    "db:seed:production": "node dist/bin/seed.js",
    "db:refresh": "node --env-file-if-exists=.env --import tsx bin/refresh.ts",
    "db:refresh:test": "node --env-file=.env.test --import tsx bin/refresh.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/http/*.test.ts",
    "pretest": "node scripts/assert-test-files.mjs unit http",
    "test:integration": "node --env-file=.env.test --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "pretest:integration": "node scripts/assert-test-files.mjs integration",
    "env:setup": "node scripts/setup-environment.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose --env-file .env.test --profile test up -d --wait postgres-test",
    "db:down": "docker compose --profile test down",
    "db:wait:test": "node --env-file=.env.test --import tsx scripts/wait-for-database.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/modules/**/*.service.ts\" --test-coverage-lines=90 --test-coverage-functions=90 tests/unit/*.test.ts tests/http/*.test.ts",
    "pretest:coverage": "node scripts/assert-test-files.mjs unit http"
  }
}
